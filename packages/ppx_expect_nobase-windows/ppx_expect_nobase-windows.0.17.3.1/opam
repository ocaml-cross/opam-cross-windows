opam-version: "2.0"
synopsis: "Cram like framework for OCaml (with stripped dependencies)"
description: """
Testing framework: fork of ppx_expect, but with less dependecies.
Original ppx_expect is a part of the Jane Street's PPX rewriters collection."""
maintainer: ["Jane Street Group, LLC" "Dmitrii Kosarev a.k.a. Kakadu"]
authors: ["Jane Street Group, LLC"]
license: "MIT"
homepage: "https://github.com/Kakadu/ppx_expect_nobase"
bug-reports: "https://github.com/Kakadu/ppx_expect_nobase/issues"
depends: [
  "dune" {>= "3.23"}
  "ocaml-windows" {>= "4.14.2" & < "5.0.0" | >= "5.3.0" & < "5.6.0"}
  "ppx_inline_test_nobase" {>= "v0.17.0.3"}
  "ppx_inline_test_nobase-windows" {>= "v0.17.0.3"}
  "sexplib-windows"
  "ppxlib" {>= "0.35.0"}
  "ppxlib-windows" {>= "0.35.0"}
  "dune-build-info-windows"
  "odoc-windows" {with-doc}
]
patches: [
  "no-opam-core-dep.patch"
]
build: [
  ["dune" "subst"] {dev}
  ["rm" "-rf" "./bin"]
  ["mkdir" "-p" "src/config"]
  ["sh" "-c" "printf \"true\" >> src/config/lt38.txt"] {ppxlib:version < "0.38.0"}
  ["sh" "-c" "printf \"false\" >> src/config/ge38.txt"] {ppxlib:version < "0.38.0"}
  ["sh" "-c" "printf \"false\" >> src/config/lt38.txt"] {ppxlib:version >= "0.38.0"}
  ["sh" "-c" "printf \"true\" >> src/config/ge38.txt"] {ppxlib:version >= "0.38.0"}
  [
    "dune"
    "build"
    "-p"
    "ppx_expect_nobase" "-x" "windows"
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["rm" "%{name}%.install"]
]
dev-repo: "git+https://github.com/Kakadu/ppx_expect_nobase.git"
